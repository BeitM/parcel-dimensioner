meta {
  name: Get box photo
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/measurements/{{measurementId}}/image
  body: none
  auth: inherit
}

docs {
  Run **Capture status** after the scan completes to load its measurement ID.
  The response is a cropped JPEG without overlays. HTTP 404 means no photo is
  linked. HTTP 410 means the photo or crop is unavailable. The Pi removes
  station photos after two weeks and the measurement stays available.
}
