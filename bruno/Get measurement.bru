meta {
  name: Get measurement
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/measurements/{{measurementId}}
  body: none
  auth: inherit
}

docs {
  Run **Capture status** after measuring to load the measurement ID. The
  response contains dimensions in inches, gross weight in pounds, and the
  barcode status. A decoded barcode is returned as a string. If the response
  includes `imageUrl`, send **Get box photo** to view the cropped JPEG.
}
